<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Crypto Portfolio Calculator</title>
  <link 
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" 
    rel="stylesheet"
  >
  <link 
    rel="stylesheet" 
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css"
  >
  <style>
    .btn-robins-egg {
      background-color: #00CCCC;
      border-color: #00CCCC;
      color: #000000;
    }
    .btn-robins-egg:hover {
      background-color: #00B3B3;
      border-color: #00B3B3;
      color: #000000;
    }
  </style>
</head>
<body class="bg-light min-vh-100 d-flex flex-column justify-content-center py-5">

  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-10 col-lg-8 text-center">

        <h1 class="fw-bold mb-4 text-dark">Crypto Portfolio Calculator</h1>

        <div class="mb-4">
          <a href="/load" class="btn btn-robins-egg btn-lg px-5 shadow-sm fw-semibold">
            <i class="bi bi-arrow-clockwise me-2"></i>Load
          </a>
        </div>

        <% if (error) { %>
          <div class="alert alert-warning alert-dismissible fade show shadow-sm text-start" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
          </div>
        <% } %>

        <% if (coins && coins.length > 0) { %>
          <div class="row g-4 mt-2">
            <% coins.forEach(function(coin) { %>
              <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0">
                  <div class="card-body text-center p-4">
                    
                    <img src="<%= coin.image %>" alt="<%= coin.name %> logo" class="mb-3" style="width: 48px; height: 48px;">
                    <h5 class="card-title fw-bold mb-1"><%= coin.name %> (<%= coin.symbol %>)</h5>
                    
                    <p class="card-text text-muted mb-3">
                      <small>1 <%= coin.symbol %> = </small>
                      <strong class="text-dark">$<%= coin.price.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> USD</strong>
                    </p>

                    <div class="mb-3">
                      <% if (coin.priceChange24h !== null && coin.priceChange24h !== undefined) { %>
                        <% const isPositive = coin.priceChange24h >= 0; %>
                        <span class="badge <%= isPositive ? 'bg-success' : 'bg-danger' %> p-2 fs-6">
                          <%= isPositive ? '+' : '' %><%= coin.priceChange24h.toFixed(2) %>% (24h)
                        </span>
                      <% } else { %>
                        <span class="badge bg-secondary p-2 fs-6">N/A</span>
                      <% } %>
                    </div>

                    <hr class="my-3">

                    <div class="bg-light p-3 rounded border">
                      <small class="text-secondary d-block fw-semibold mb-1">Purchasable with $1,000 USD:</small>
                      <h6 class="fw-bold text-primary mb-0"><%= coin.unitsFor1000 %> <%= coin.symbol %></h6>
                    </div>

                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        <% } %>

      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>